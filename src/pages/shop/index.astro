---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const items = (await getCollection('shop')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<Layout title="SHOP | 輪廻タヲ" description="輪廻タヲの物販一覧">
  <div class="pt-24 pb-16 px-5 md:px-8 min-h-screen">
    <div class="max-w-3xl mx-auto">

      <div class="py-12 mb-8">
        <h1 class="font-mincho text-text-primary text-3xl font-light tracking-[0.3em]">Shop</h1>
      </div>

      <div class="grid grid-cols-2 md:grid-cols-3 gap-5">
        {items.map(item => (
          <a href={`/shop/${item.slug}`} class="group block">
            <div class="relative aspect-square overflow-hidden rounded-sm bg-[#1e1c18] mb-3">
              <img
                src={item.data.heroImage}
                alt={item.data.title}
                class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
              />
              {item.data.status === 'soldout' && (
                <div class="absolute inset-0 bg-black/60 flex items-center justify-center">
                  <span class="text-text-primary text-[11px] tracking-[0.2em] border border-white/40 px-3 py-1">SOLD OUT</span>
                </div>
              )}
            </div>
            <p class="font-mincho text-text-primary text-[14px] font-light tracking-wider mb-1">{item.data.title}</p>
            <p class="text-text-faint text-[12px] font-light">{item.data.price}</p>
          </a>
        ))}
      </div>

    </div>
  </div>
</Layout>
