---
import Layout from '../layouts/Layout.astro';
import { movieCategories, movieCatGroup, works } from '../data/gallery-works';

const videoWorks = works.filter(w => movieCatGroup.includes(w.cat));
const movieCount = videoWorks.filter(w => w.cat === 'movie').length;
const mvCount = videoWorks.filter(w => w.cat === 'mv').length;
const charMovieCount = videoWorks.filter(w => w.cat === 'charmovie').length;
---

<Layout title="MOVIE | 輪廻タヲ" description="輪廻タヲの映像作品ギャラリー。Music Video・Character Movieなどカテゴリ別に一覧・再生できます。" ogImage="/gallery-og.png">
  <div class="pt-24 pb-16 px-5 md:px-16 lg:px-24 min-h-screen">

    <div class="py-12 mb-8">
      <h1 class="font-mincho text-text-primary text-3xl font-light tracking-[0.3em]">Movie</h1>
      <p class="text-text-faint text-[11px] tracking-[0.15em] font-light mt-4">Movie {movieCount} / Music Video {mvCount} / Character Movie {charMovieCount}</p>
    </div>

    <!-- カテゴリフィルター -->
    <div class="flex flex-wrap gap-x-6 gap-y-2 mb-6 text-[11px] tracking-[0.25em] font-light">
      {movieCategories.map((cat, i) => (
        <button
          data-cat={cat.id}
          class:list={['filter-btn pb-px transition-colors duration-300', i === 0 ? 'text-text-primary border-b border-text-primary' : 'text-text-faint hover:text-text-muted']}
        >
          {cat.label}
        </button>
      ))}
    </div>

    <!-- 並び替え -->
    <div class="flex gap-6 mb-10 text-[11px] tracking-[0.25em] font-light">
      <button data-sort="random" class="sort-btn pb-px transition-colors duration-300 text-text-primary border-b border-text-primary">ランダム</button>
      <button data-sort="new" class="sort-btn pb-px transition-colors duration-300 text-text-faint hover:text-text-muted">新着順</button>
    </div>

    <!-- ギャラリー -->
    <div id="gallery-grid" class="columns-2 gap-1 space-y-1 md:columns-none md:grid md:grid-cols-3 md:gap-3 md:space-y-0 lg:grid-cols-4"></div>

    <!-- 無限スクロール sentinel -->
    <div id="sentinel" class="h-16"></div>

  </div>
</Layout>

<!-- Lightbox -->
<div id="lightbox" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/90" role="dialog" aria-modal="true">
  <button id="lb-close" class="absolute top-4 right-5 text-white/70 hover:text-white text-2xl font-light z-20" aria-label="閉じる">×</button>
  <div id="lb-swipe-hint" class="absolute top-[8%] left-1/2 -translate-x-1/2 bg-black/70 px-3 py-1.5 rounded-sm text-white/70 text-[12px] tracking-wider text-center whitespace-nowrap pointer-events-none">← 左右にスワイプ →</div>
  <button id="lb-prev" class="hidden md:flex absolute left-[16%] top-1/2 -translate-y-1/2 z-10 w-10 h-10 rounded-full bg-white/10 border border-white/70 hover:bg-white/20 items-center justify-center text-white/70 hover:text-white transition-all" aria-label="前へ">
    <svg width="10" height="16" viewBox="0 0 10 16" fill="none"><polyline points="8,2 2,8 8,14" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
  </button>
  <button id="lb-next" class="hidden md:flex absolute right-[16%] top-1/2 -translate-y-1/2 z-10 w-10 h-10 rounded-full bg-white/10 border border-white/70 hover:bg-white/20 items-center justify-center text-white/70 hover:text-white transition-all" aria-label="次へ">
    <svg width="10" height="16" viewBox="0 0 10 16" fill="none"><polyline points="2,2 8,8 2,14" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
  </button>
  <div id="lb-swipe-area" class="relative w-full h-full overflow-hidden touch-pan-y">
  <div id="lb-track" class="w-full h-full flex">
    <div class="w-full h-full shrink-0 flex items-center justify-center">
      <img id="lb-img-prev" src="" alt="" class="max-h-[90vh] max-w-[90vw] object-contain select-none pointer-events-none" />
    </div>
    <div class="w-full h-full shrink-0 flex items-center justify-center">
      <video id="lb-video" src="" playsinline controls class="hidden max-h-[90vh] max-w-[90vw] select-none"></video>
      <iframe id="lb-youtube" src="" title="" class="hidden w-full max-w-4xl aspect-video" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; fullscreen" allowfullscreen></iframe>
    </div>
    <div class="w-full h-full shrink-0 flex items-center justify-center">
      <img id="lb-img-next" src="" alt="" class="max-h-[90vh] max-w-[90vw] object-contain select-none pointer-events-none" />
    </div>
  </div>
  </div>
  <div id="lb-filename" class="absolute bottom-[5%] left-1/2 -translate-x-1/2 bg-black/70 px-2 py-1 rounded-sm text-white/40 text-[10px] font-mono tracking-wider"></div>
</div>

<script define:vars={{ works: videoWorks, movieCatGroup }}>
  const BATCH = 48;
  const grid = document.getElementById('gallery-grid');
  const sentinel = document.getElementById('sentinel');
  const btns = document.querySelectorAll('.filter-btn');
  const sortBtns = document.querySelectorAll('.sort-btn');

  let filtered = [];
  let rendered = 0;
  let currentCat = 'all';
  let sortMode = 'random';

  // ===== シャッフル（Fisher-Yates） =====
  function shuffle(arr) {
    const a = arr.slice();
    for (let i = a.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      [a[i], a[j]] = [a[j], a[i]];
    }
    return a;
  }

  // ===== アイテム生成 =====
  function makeItem(w) {
    const isYoutube = w.type === 'youtube';
    const posterSrc = isYoutube
      ? `https://img.youtube.com/vi/${w.youtubeId}/hqdefault.jpg`
      : (w.poster ?? `/gallery/${w.file}.webp`);
    const div = document.createElement('div');
    div.className = 'gallery-item break-inside-avoid overflow-hidden group cursor-pointer relative md:aspect-square md:rounded-md md:bg-[#1e1c18]';
    div.dataset.cat = w.cat;
    div.dataset.src = posterSrc;
    div.dataset.file = w.file;
    if (isYoutube) {
      div.dataset.type = 'youtube';
      div.dataset.youtubeId = w.youtubeId;
    } else {
      div.dataset.type = 'video';
      div.dataset.videoSrc = w.src ?? `/gallery/${w.file}.mp4`;
    }

    const img = document.createElement('img');
    img.src = posterSrc;
    img.alt = '';
    img.loading = 'lazy';
    img.className = 'w-full block transition-transform duration-700 group-hover:scale-[1.03] md:w-full md:h-full md:object-cover';

    div.appendChild(img);

    const playIcon = document.createElement('div');
    playIcon.className = 'absolute inset-0 flex items-center justify-center bg-black/10 group-hover:bg-black/30 transition-colors duration-300 pointer-events-none';
    playIcon.innerHTML = '<svg class="w-9 h-9 text-white opacity-90" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>';
    div.appendChild(playIcon);

    div.addEventListener('click', () => openLightbox(div));
    return div;
  }

  // ===== バッチ追加 =====
  function loadMore() {
    const batch = filtered.slice(rendered, rendered + BATCH);
    if (batch.length === 0) {
      io.unobserve(sentinel);
      return;
    }
    const frag = document.createDocumentFragment();
    batch.forEach(w => frag.appendChild(makeItem(w)));
    grid.appendChild(frag);
    rendered += batch.length;
  }

  // ===== フィルター・並び替え =====
  function render() {
    const base = currentCat === 'all' ? works : works.filter(w => w.cat === currentCat);
    filtered = sortMode === 'new' ? base.slice() : shuffle(base);
    rendered = 0;
    grid.innerHTML = '';
    btns.forEach(b => {
      const active = b.dataset.cat === currentCat;
      b.classList.toggle('text-text-primary', active);
      b.classList.toggle('border-b', active);
      b.classList.toggle('border-text-primary', active);
      b.classList.toggle('text-text-faint', !active);
    });
    sortBtns.forEach(b => {
      const active = b.dataset.sort === sortMode;
      b.classList.toggle('text-text-primary', active);
      b.classList.toggle('border-b', active);
      b.classList.toggle('border-text-primary', active);
      b.classList.toggle('text-text-faint', !active);
    });
    // 既にobserve中のターゲットへの再observe()は仕様上ノーオペレーションで発火しない。
    // 切替のたびに毎回「新規observe」扱いにして初回発火を保証する。
    io.unobserve(sentinel);
    io.observe(sentinel);
  }

  // ===== IntersectionObserver =====
  const io = new IntersectionObserver(entries => {
    if (entries[0].isIntersecting) loadMore();
  }, { rootMargin: '200px' });

  btns.forEach(btn => btn.addEventListener('click', () => { currentCat = btn.dataset.cat; render(); }));
  sortBtns.forEach(btn => btn.addEventListener('click', () => { sortMode = btn.dataset.sort; render(); }));

  currentCat = new URLSearchParams(window.location.search).get('cat') ?? 'all';
  render();

  // ===== Lightbox =====
  const lb = document.getElementById('lightbox');
  const lbSwipeArea = document.getElementById('lb-swipe-area');
  const lbTrack = document.getElementById('lb-track');
  const lbVideo = document.getElementById('lb-video');
  const lbYoutube = document.getElementById('lb-youtube');
  const lbImgPrev = document.getElementById('lb-img-prev');
  const lbImgNext = document.getElementById('lb-img-next');
  const lbFilename = document.getElementById('lb-filename');
  let lbIndex = 0;

  function getRenderedItems() {
    return Array.from(grid.querySelectorAll('.gallery-item'));
  }

  function neighborSrc(offset) {
    const items = getRenderedItems();
    if (items.length === 0) return '';
    const idx = (lbIndex + offset + items.length) % items.length;
    return items[idx]?.dataset.src ?? '';
  }

  function resetTrack(instant) {
    lbTrack.style.transition = instant ? 'none' : 'transform 250ms ease-out';
    lbTrack.style.transform = 'translateX(-100%)';
  }

  function openLightbox(clickedEl) {
    const items = getRenderedItems();
    lbIndex = items.indexOf(clickedEl);
    showLb(items[lbIndex]);
    lb.classList.remove('hidden');
    lb.classList.add('flex');
    document.body.style.overflow = 'hidden';
  }

  function showLb(el) {
    lbVideo.pause();
    lbVideo.removeAttribute('src');
    lbVideo.load();
    lbYoutube.src = '';
    const isYoutube = el.dataset.type === 'youtube';
    lbVideo.classList.add('hidden');
    lbYoutube.classList.add('hidden');
    if (isYoutube) {
      lbYoutube.classList.remove('hidden');
      lbYoutube.src = `https://www.youtube.com/embed/${el.dataset.youtubeId}?autoplay=1`;
    } else {
      lbVideo.classList.remove('hidden');
      lbVideo.src = el.dataset.videoSrc;
      lbVideo.play();
    }
    lbFilename.textContent = el.dataset.file ?? '';
    lbImgPrev.src = neighborSrc(-1);
    lbImgNext.src = neighborSrc(1);
    resetTrack(true);
  }

  function closeLightbox() {
    lb.classList.add('hidden');
    lb.classList.remove('flex');
    document.body.style.overflow = '';
    lbVideo.pause();
    lbVideo.removeAttribute('src');
    lbVideo.load();
    lbYoutube.src = '';
  }

  function lbGo(delta) {
    const items = getRenderedItems();
    // 末尾付近でさらに読み込み
    if (lbIndex + delta >= items.length - 4 && rendered < filtered.length) {
      loadMore();
    }
    lbIndex = (lbIndex + delta + items.length) % items.length;
    showLb(getRenderedItems()[lbIndex]);
  }

  document.getElementById('lb-prev')?.addEventListener('click', () => lbGo(-1));
  document.getElementById('lb-next')?.addEventListener('click', () => lbGo(1));
  document.getElementById('lb-close')?.addEventListener('click', closeLightbox);
  lb.addEventListener('click', e => { if (e.target === lb) closeLightbox(); });
  document.addEventListener('keydown', e => {
    if (lb.classList.contains('hidden')) return;
    if (e.key === 'Escape') closeLightbox();
    if (e.key === 'ArrowLeft') lbGo(-1);
    if (e.key === 'ArrowRight') lbGo(1);
  });

  // ===== ライトボックス スワイプ（指の動きに追従） =====
  let lbDragging = false;
  let lbDragStartX = 0;
  let lbDragStartY = 0;
  let lbDragDeltaX = 0;
  let lbAreaWidth = 0;

  lbSwipeArea.addEventListener('touchstart', e => {
    lbDragging = true;
    lbDragStartX = e.touches[0].clientX;
    lbDragStartY = e.touches[0].clientY;
    lbDragDeltaX = 0;
    lbAreaWidth = lbSwipeArea.clientWidth;
    lbTrack.style.transition = 'none';
  }, { passive: true });

  lbSwipeArea.addEventListener('touchmove', e => {
    if (!lbDragging) return;
    const dx = e.touches[0].clientX - lbDragStartX;
    const dy = e.touches[0].clientY - lbDragStartY;
    if (Math.abs(dy) > Math.abs(dx)) return;
    lbDragDeltaX = dx;
    lbTrack.style.transform = `translateX(calc(-100% + ${dx}px))`;
  }, { passive: true });

  lbSwipeArea.addEventListener('touchend', () => {
    if (!lbDragging) return;
    lbDragging = false;
    const threshold = lbAreaWidth * 0.15;
    if (Math.abs(lbDragDeltaX) > threshold) {
      const dir = lbDragDeltaX < 0 ? 1 : -1;
      lbTrack.style.transition = 'transform 250ms ease-out';
      lbTrack.style.transform = `translateX(${dir < 0 ? '0%' : '-200%'})`;
      setTimeout(() => lbGo(dir), 250);
    } else {
      resetTrack(false);
    }
  }, { passive: true });
</script>
