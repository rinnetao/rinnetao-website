---
import Layout from '../../layouts/Layout.astro';
import { getCollection, type CollectionEntry } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map(post => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { Content } = await post.render();

const allPosts = await getCollection('blog');
const relatedPosts = (post.data.relatedSlugs ?? [])
  .map(slug => allPosts.find(p => p.slug === slug))
  .filter((p): p is CollectionEntry<'blog'> => Boolean(p));

function formatDate(d: Date) {
  return d.toISOString().slice(0, 10).replace(/-/g, '.');
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site).toString();

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.date.toISOString(),
  dateModified: (post.data.updatedDate ?? post.data.date).toISOString(),
  author: { '@type': 'Person', name: '輪廻タヲ' },
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonicalURL },
  ...(post.data.ogImage ? { image: new URL(post.data.ogImage, Astro.site).toString() } : {}),
};
---

<Layout
  title={`${post.data.title} | 輪廻タヲ BLOG`}
  description={post.data.description}
  ogImage={post.data.ogImage}
  ogType="article"
  jsonLd={jsonLd}
>
  <article class="pt-24 pb-16 px-5 md:px-8 min-h-screen">
    <div class="max-w-2xl mx-auto">

      <div class="py-12 mb-8">
        <p class="text-text-faint text-[10px] tracking-[0.2em] font-mono mb-4">
          {formatDate(post.data.date)}
        </p>
        <h1 class="font-mincho text-text-primary text-2xl md:text-3xl font-light tracking-[0.1em] leading-relaxed">
          {post.data.title}
        </h1>
        <p class="text-text-faint text-[11px] font-light tracking-wider mt-4">
          執筆: 輪廻タヲ ・ AIを活用した音楽・イラスト・映像作品を制作するコンテンツクリエイター
        </p>
      </div>

      <div class="blog-content text-text-muted text-[15px] font-light leading-[2]">
        <Content />
      </div>

      <div class="not-prose my-10 border border-accent-line px-6 py-8">
        <div class="flex items-center gap-4 mb-5">
          <img src="/icon.webp" alt="輪廻タヲ" class="w-16 h-16 md:w-20 md:h-20 object-cover rounded-sm shrink-0" />
          <div>
            <p class="font-mincho text-text-primary text-base font-light tracking-wider mb-1">輪廻タヲ / Rinne Tao</p>
            <p class="text-text-muted text-[13px] font-light leading-relaxed">
              AIを制作に活用するコンテンツクリエイター。音楽、イラスト、映像作品を中心に発信しています。
            </p>
          </div>
        </div>
        <p class="text-text-muted text-[13px] font-light leading-relaxed mb-4">
          最新作品やAIに関する考察はXで発信しています。
        </p>
        <a
          href="https://x.com/TaoRInne"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-block px-6 py-[10px] bg-white !text-[#1a1a1a] !no-underline text-[11px] font-sans-jp font-bold tracking-[0.15em] hover:bg-white/85 transition-all duration-300"
        >
          @TaoRInne をフォローする
        </a>
      </div>

      {relatedPosts.length > 0 && (
        <div class="mt-10">
          <p class="text-text-faint text-[10px] tracking-[0.3em] font-light uppercase mb-4">関連記事</p>
          <div class="space-y-1">
            {relatedPosts.map(rp => (
              <a href={`/blog/${rp.slug}`} class="flex items-center gap-4 border-b border-accent-line py-4 hover:opacity-80 transition-opacity duration-300">
                {rp.data.ogImage && (
                  <img src={rp.data.ogImage} alt={rp.data.title} loading="lazy" class="w-16 h-16 md:w-20 md:h-20 object-cover shrink-0" />
                )}
                <div class="min-w-0">
                  <p class="text-text-faint text-[10px] tracking-[0.2em] font-mono mb-1">{formatDate(rp.data.date)}</p>
                  <p class="font-mincho text-text-primary text-[14px] font-light tracking-wider">{rp.data.title}</p>
                </div>
              </a>
            ))}
          </div>
        </div>
      )}

      <div class="mt-16 pt-8 border-t border-accent-line">
        <a href="/blog" class="text-text-faint text-[10px] tracking-[0.3em] font-light hover:text-text-muted transition-colors duration-300">← 記事一覧へ戻る</a>
      </div>

    </div>
  </article>

  <!-- YouTube タイムスタンプ ライトボックス -->
  <div id="yt-lightbox" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/95 px-4 md:px-20 lg:px-24" role="dialog" aria-modal="true">
    <button id="yt-lightbox-close" class="absolute top-4 right-5 text-white/70 hover:text-white text-2xl font-light z-10" aria-label="閉じる">×</button>
    <div class="w-full max-w-4xl aspect-video" onclick="event.stopPropagation()">
      <iframe id="yt-lightbox-frame" src="" class="w-full h-full" title="YouTube video player" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>
    </div>
  </div>
</Layout>

<script>
  function parseYouTubeUrl(url: string) {
    try {
      const u = new URL(url);
      if (!/(^|\.)youtube\.com$/.test(u.hostname) || u.pathname !== '/watch') return null;
      const id = u.searchParams.get('v');
      if (!id) return null;
      const t = u.searchParams.get('t');
      let start = 0;
      if (t) {
        const match = t.match(/^(\d+)/);
        if (match) start = parseInt(match[1], 10);
      }
      return { id, start };
    } catch {
      return null;
    }
  }

  const lightbox = document.getElementById('yt-lightbox');
  const frame = document.getElementById('yt-lightbox-frame') as HTMLIFrameElement | null;

  function openYtLightbox(id: string, start: number) {
    if (!lightbox || !frame) return;
    frame.src = `https://www.youtube.com/embed/${id}?start=${start}&autoplay=1&rel=0`;
    lightbox.classList.remove('hidden');
    lightbox.classList.add('flex');
    document.body.style.overflow = 'hidden';
  }

  function closeYtLightbox() {
    if (!lightbox || !frame) return;
    frame.src = '';
    lightbox.classList.add('hidden');
    lightbox.classList.remove('flex');
    document.body.style.overflow = '';
  }

  document.querySelectorAll<HTMLAnchorElement>('.blog-content a[href*="youtube.com/watch"]').forEach(a => {
    a.addEventListener('click', (e) => {
      const parsed = parseYouTubeUrl(a.href);
      if (!parsed) return;
      e.preventDefault();
      openYtLightbox(parsed.id, parsed.start);
    });
  });

  document.getElementById('yt-lightbox-close')?.addEventListener('click', closeYtLightbox);
  lightbox?.addEventListener('click', (e) => {
    if (e.target === lightbox) closeYtLightbox();
  });
  document.addEventListener('keydown', e => {
    if (!lightbox || lightbox.classList.contains('hidden')) return;
    if (e.key === 'Escape') closeYtLightbox();
  });
</script>

<style>
  .blog-content :global(h2) {
    font-family: 'Cormorant Garamond', 'Shippori Mincho', serif;
    color: theme('colors.text.primary');
    font-size: 1.15rem;
    font-weight: 300;
    letter-spacing: 0.1em;
    margin-top: 2.5rem;
    margin-bottom: 1rem;
    scroll-margin-top: 88px;
  }
  .blog-content :global(details.toc) {
    border: 1px solid theme('colors.accent.line');
    background: rgba(255, 255, 255, 0.02);
    margin: 2rem 0;
    padding: 1rem 1.25rem;
  }
  .blog-content :global(details.toc summary) {
    cursor: pointer;
    color: theme('colors.text.primary');
    font-size: 12px;
    letter-spacing: 0.2em;
    font-weight: 700;
    list-style: none;
  }
  .blog-content :global(details.toc summary::-webkit-details-marker) {
    display: none;
  }
  .blog-content :global(details.toc summary::before) {
    content: '▶';
    display: inline-block;
    margin-right: 0.5em;
    font-size: 9px;
    transition: transform 0.2s ease;
  }
  .blog-content :global(details.toc[open] summary::before) {
    transform: rotate(90deg);
  }
  .blog-content :global(p.toc-day) {
    margin: 0.9rem 0 0;
    line-height: 2;
  }
  .blog-content :global(details.toc p.toc-day:first-of-type) {
    margin-top: 1rem;
  }
  .blog-content :global(span.toc-day-label) {
    display: inline-block;
    color: theme('colors.text.faint');
    font-size: 11px;
    letter-spacing: 0.15em;
    margin-right: 0.75rem;
  }
  .blog-content :global(details.toc a) {
    color: theme('colors.text.muted');
    font-size: 12px;
    text-decoration: underline;
    text-underline-offset: 2px;
    margin-right: 0.9rem;
    white-space: nowrap;
  }
  .blog-content :global(details.toc a:hover) {
    color: theme('colors.text.primary');
  }
  .blog-content :global(h2.tent-red) {
    color: #e2685e;
    border-left: 2px solid #a83228;
    padding-left: 0.75rem;
  }
  .blog-content :global(h2.tent-blue) {
    color: #5cbdec;
    border-left: 2px solid #2f7094;
    padding-left: 0.75rem;
  }
  .blog-content :global(h2.tent-green) {
    color: #7ed85e;
    border-left: 2px solid #3d6b2c;
    padding-left: 0.75rem;
  }
  .blog-content :global(h2.tent-okan) {
    color: #f2d94a;
    border-left: 2px solid #9c7d1a;
    padding-left: 0.75rem;
  }
  .blog-content :global(p) {
    margin-bottom: 1.5rem;
  }
  .blog-content :global(ul),
  .blog-content :global(ol) {
    margin: 1.5rem 0;
    padding-left: 1.5rem;
  }
  .blog-content :global(li) {
    margin-bottom: 0.5rem;
    list-style-position: outside;
  }
  .blog-content :global(a) {
    color: theme('colors.text.primary');
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .blog-content :global(strong) {
    color: theme('colors.text.primary');
    font-weight: 700;
  }
  .blog-content :global(img) {
    width: 100%;
    margin: 2rem 0;
  }
  .blog-content :global(video) {
    width: 100%;
    margin: 2rem 0;
  }
  .blog-content :global(blockquote) {
    margin: 2rem 0;
    padding: 1rem 1.5rem;
    border-left: 2px solid theme('colors.accent.line');
    background: rgba(255, 255, 255, 0.02);
  }
  .blog-content :global(blockquote p) {
    margin-bottom: 0.75rem;
  }
  .blog-content :global(blockquote p:last-child) {
    margin-bottom: 0;
  }
  .blog-content :global(table) {
    display: block;
    overflow-x: auto;
    white-space: nowrap;
    margin: 2rem 0;
    border-collapse: collapse;
    font-size: 12px;
    scrollbar-width: thin;
    scrollbar-color: theme('colors.text.faint') transparent;
  }
  .blog-content :global(table::-webkit-scrollbar) {
    height: 6px;
  }
  .blog-content :global(table::-webkit-scrollbar-thumb) {
    background: theme('colors.text.faint');
    border-radius: 3px;
  }
  .blog-content :global(table::-webkit-scrollbar-track) {
    background: rgba(255, 255, 255, 0.04);
  }
  .blog-content :global(th),
  .blog-content :global(td) {
    padding: 0.6rem 1rem;
    border: 1px solid theme('colors.accent.line');
    text-align: left;
  }
  .blog-content :global(th) {
    color: theme('colors.text.primary');
    font-weight: 700;
    background: rgba(255, 255, 255, 0.03);
  }
</style>
