---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Contact | Rinne Tao" description="Contact Rinne Tao for music, illustration, video and web projects.">
  <main class="pt-24 pb-16 px-5 md:px-8 min-h-screen">
    <div class="max-w-xl mx-auto">
      <div class="py-12 mb-10">
        <p class="text-text-faint text-[10px] tracking-[0.4em] mb-3">CONTACT</p>
        <h1 class="font-mincho text-text-primary text-3xl font-light tracking-[0.2em]">Get in touch</h1>
      </div>
      <p class="text-text-muted text-[14px] leading-[2.1] mb-10">For commissions, collaborations and other enquiries, please use the form below. Please include a short description of your project, intended use and desired schedule.</p>
      <form id="contact-form-en" class="space-y-4">
        <input type="hidden" name="access_key" value="b893875f-b41b-4bc0-926c-46c26cce4772" />
        <input type="hidden" name="subject" value="[Rinne Tao] Contact form" />
        <input type="text" name="botcheck" class="hidden" tabindex="-1" autocomplete="off" />
        <label class="block text-text-faint text-[10px] tracking-[0.2em]">NAME<input name="name" required class="mt-2 w-full bg-[#131110] border border-white/[0.1] text-text-primary text-sm px-4 py-3 focus:outline-none focus:border-white/30" /></label>
        <label class="block text-text-faint text-[10px] tracking-[0.2em]">EMAIL<input name="email" type="email" required class="mt-2 w-full bg-[#131110] border border-white/[0.1] text-text-primary text-sm px-4 py-3 focus:outline-none focus:border-white/30" /></label>
        <label class="block text-text-faint text-[10px] tracking-[0.2em]">PROJECT TYPE<select name="category" required class="mt-2 w-full bg-[#131110] border border-white/[0.1] text-text-primary text-sm px-4 py-3 focus:outline-none focus:border-white/30"><option value="" selected disabled>Select a category</option><option>Music / Sound</option><option>Illustration</option><option>Video / MV</option><option>Web / Other</option></select></label>
        <label class="block text-text-faint text-[10px] tracking-[0.2em]">MESSAGE<textarea name="message" rows="7" required class="mt-2 w-full bg-[#131110] border border-white/[0.1] text-text-primary text-sm px-4 py-3 focus:outline-none focus:border-white/30 resize-y"></textarea></label>
        <button type="submit" class="block w-full px-5 py-3 bg-white text-[#1a1a1a] text-[11px] font-bold tracking-[0.2em] rounded-sm hover:bg-white/85">SEND</button>
        <p id="contact-status-en" class="text-xs text-center hidden"></p>
      </form>
    </div>
  </main>
</Layout>
<script>
  const form = document.getElementById('contact-form-en') as HTMLFormElement | null;
  const status = document.getElementById('contact-status-en');
  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    const button = form.querySelector('button') as HTMLButtonElement;
    button.disabled = true; button.textContent = 'SENDING…';
    try {
      const response = await fetch('https://api.web3forms.com/submit', { method: 'POST', headers: { Accept: 'application/json' }, body: new FormData(form) });
      const result = await response.json();
      if (!result.success) throw new Error(result.message);
      form.reset(); if (status) { status.textContent = 'Thank you. I will get back to you soon.'; status.className = 'text-xs text-center text-text-primary mt-2'; }
    } catch { if (status) { status.textContent = 'Could not send your message. Please try again later.'; status.className = 'text-xs text-center text-accent-red mt-2'; } }
    finally { button.disabled = false; button.textContent = 'SEND'; }
  });
</script>
