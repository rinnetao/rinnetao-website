---
import Layout from '../../layouts/Layout.astro';
import { getCollection, type CollectionEntry } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('news');
  return posts.map(post => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

interface Props {
  post: CollectionEntry<'news'>;
}

const { post } = Astro.props;
const { Content } = await post.render();

function formatDate(d: Date) {
  return d.toISOString().slice(0, 10).replace(/-/g, '.');
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site).toString();

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.date.toISOString(),
  dateModified: (post.data.updatedDate ?? post.data.date).toISOString(),
  author: { '@type': 'Person', name: '輪廻タヲ' },
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonicalURL },
  ...(post.data.ogImage ? { image: new URL(post.data.ogImage, Astro.site).toString() } : {}),
};
---

<Layout
  title={`${post.data.title} | 輪廻タヲ NEWS`}
  description={post.data.description}
  ogImage={post.data.ogImage}
  ogType="article"
  jsonLd={jsonLd}
>
  <article class:list={['pt-24', 'pb-16', 'px-5', 'md:px-8', 'min-h-screen', { 'ai-music-voices-page': post.slug === 'ai-music-voices' }]}>
    <div class="max-w-2xl mx-auto">

      <div class="py-12 mb-8">
        <p class="text-text-faint text-[10px] tracking-[0.2em] font-mono mb-4">{formatDate(post.data.date)}</p>
        <h1 class="font-mincho text-text-primary text-2xl md:text-3xl font-light tracking-[0.1em] leading-relaxed">
          {post.data.titleHtml ? <Fragment set:html={post.data.titleHtml} /> : post.data.title}
        </h1>
      </div>

      {post.data.ogImage && (
        post.data.imageLink ? (
          <a href={post.data.imageLink} target="_blank" rel="noopener noreferrer" class="block mb-10 bg-black rounded-sm">
            <img src={post.data.ogImage} alt={post.data.title} class="w-full aspect-video object-contain rounded-sm" />
          </a>
        ) : (
          <div class="mb-10 bg-black rounded-sm">
            <img src={post.data.ogImage} alt={post.data.title} class="w-full aspect-video object-contain rounded-sm" />
          </div>
        )
      )}

      <div class="news-content text-text-muted text-[15px] font-light leading-[2] whitespace-pre-line">
        <Content />
      </div>

      <div class="mt-16 pt-8 border-t border-accent-line">
        <a href="/#news" class="text-text-faint text-[10px] tracking-[0.3em] font-light hover:text-text-muted transition-colors duration-300">← トップへ戻る</a>
      </div>

    </div>
  </article>
</Layout>

<style>
  .news-content :global(p) {
    margin-bottom: 1.5rem;
  }
  .news-content :global(.live-information) {
    margin-bottom: 1.5rem;
  }
  .news-content :global(a) {
    color: theme('colors.text.primary');
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .news-content > :global(h2) {
    font-family: 'Cormorant Garamond', 'Shippori Mincho', serif;
    color: theme('colors.text.primary');
    font-size: 1.15rem;
    font-weight: 300;
    letter-spacing: 0.1em;
    line-height: 1.8;
    border-bottom: 2px solid rgba(245, 245, 240, 0.82);
    padding-bottom: 0.55rem;
    margin-top: 3.5rem;
    margin-bottom: 1.25rem;
    scroll-margin-top: 88px;
  }
  .news-content > :global(h3) {
    color: theme('colors.text.primary');
    font-size: 1rem;
    font-weight: 300;
    letter-spacing: 0.08em;
    line-height: 1.7;
    border-bottom: 1px solid rgba(245, 245, 240, 0.48);
    padding-bottom: 0.35rem;
    margin-bottom: 0.9rem;
  }
  .news-content :global(hr) {
    height: 1px;
    border: 0;
    background: rgba(245, 245, 240, 0.28);
    margin: 3rem 0;
  }

  .ai-music-voices-page {
    background: #f5c842;
    color: #241d08;
    font-family: 'Sawarabi Gothic', sans-serif;
  }
  .ai-music-voices-page :global(*) {
    font-family: 'Sawarabi Gothic', sans-serif;
  }
  .ai-music-voices-page > .max-w-2xl > div:first-child :global(p),
  .ai-music-voices-page > .max-w-2xl > div:first-child :global(h1) {
    color: #241d08;
  }
  .ai-music-voices-page .news-content {
    background: #fff;
    color: #111;
    padding: 1.5rem;
  }
  .ai-music-voices-page .news-content :global(p) {
    margin-bottom: 0.5rem;
  }
  @media (min-width: 768px) {
    .ai-music-voices-page .news-content {
      padding: 2rem;
    }
  }
  .ai-music-voices-page .news-content :global(h2),
  .ai-music-voices-page .news-content :global(h3),
  .ai-music-voices-page .news-content :global(strong),
  .ai-music-voices-page .news-content :global(a),
  .ai-music-voices-page .news-content :global(li),
  .ai-music-voices-page .news-content :global(p) {
    color: #241d08;
  }
  .ai-music-voices-page .news-content > :global(h2) {
    border-bottom-color: rgba(36, 29, 8, 0.65);
  }
  .ai-music-voices-page .news-content > :global(h3) {
    border-bottom-color: rgba(36, 29, 8, 0.4);
  }
  .ai-music-voices-page .news-content :global(hr) {
    background: rgba(36, 29, 8, 0.3);
  }
  .ai-music-voices-page .news-content :global(.border-accent-line),
  .ai-music-voices-page nav {
    border-color: rgba(36, 29, 8, 0.45);
  }
  .ai-music-voices-page .news-content :global(input),
  .ai-music-voices-page .news-content :global(textarea) {
    background: #fff;
    color: #111;
    border-color: rgba(17, 17, 17, 0.45);
  }
  .ai-music-voices-page .news-content :global(label),
  .ai-music-voices-page .news-content :global(label span),
  .ai-music-voices-page .news-content :global(input::placeholder),
  .ai-music-voices-page .news-content :global(textarea::placeholder) {
    color: #333;
  }
  .ai-music-voices-page .news-content :global(form) {
    background: #fff;
    border-color: rgba(17, 17, 17, 0.45);
  }
  .ai-music-voices-page .news-content :global(button) {
    background: #111;
    color: #fff;
  }
</style>
