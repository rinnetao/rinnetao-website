---
import Layout from '../layouts/Layout.astro';

// Stripe Payment Link（配送先住所収集ON、在庫上限設定済みのものを発行後、ここに設定する）
const stripeLink = 'https://buy.stripe.com/REPLACE_ME';

const spreads = [
  { file: 'tao-book-spread1.jpg', alt: '「TAO」作品集 誌面サンプル（イラストと詩）' },
  { file: 'tao-book-spread2.jpg', alt: '「TAO」作品集 誌面サンプル（AI制作についての読み物）' },
  { file: 'tao-book-spread3.jpg', alt: '「TAO」作品集 誌面サンプル' },
];
---

<Layout title="作品集「TAO」| 輪廻タヲ" description="輪廻タヲの複合メディア作品集「TAO」。7曲の音楽とイラスト40Pを収録。数量限定での販売です。" ogImage="/book/tao-book-hero.jpg">
  <div class="pt-24 pb-16 px-5 md:px-8 min-h-screen">
    <div class="max-w-xl mx-auto">

      <div class="py-8 mb-8">
        <p class="text-text-faint text-[10px] tracking-[0.4em] mb-3 font-light">BOOK</p>
        <h1 class="font-mincho text-text-primary text-3xl font-light tracking-[0.3em]">作品集「TAO」</h1>
      </div>

      <img src="/book/tao-book-hero.jpg" alt="作品集「TAO」" class="w-full mb-8" />

      <p class="text-text-muted text-[14px] font-light leading-[2.2] mb-2">
        7曲の音楽と、イラスト40Pの作品集。
      </p>
      <p class="text-text-muted text-[14px] font-light leading-[2.2] mb-8">
        音楽はQRコードからのダウンロード形式（CDは付属しません）。<br />
        AI作品の中から厳選したイラストと、AI制作についての読み物を収録しています。
      </p>

      <div class="flex items-baseline justify-between border-t border-b border-accent-line py-5 mb-8">
        <span class="font-mincho text-text-primary text-base font-light tracking-wider">価格</span>
        <span class="text-text-primary text-xl font-sans-jp font-bold tracking-wide">¥2,000<span class="text-text-faint text-[12px] font-light ml-1">（税込・送料込）</span></span>
      </div>

      <a
        href={stripeLink}
        target="_blank"
        rel="noopener noreferrer"
        class="block text-center mb-4 px-5 py-4 bg-white text-[#1a1a1a] text-[13px] font-sans-jp font-bold tracking-[0.15em] rounded-sm hover:bg-white/85 transition-all duration-300"
      >
        購入する
      </a>
      <p class="text-text-faint text-[11px] font-light leading-[2] mb-16 text-center">
        数量限定のため、在庫がなくなり次第販売終了となります。<br />
        決済画面にて配送先ご住所のご入力をお願いします。
      </p>

      <div class="space-y-6 mb-16">
        {spreads.map(({ file, alt }) => (
          <img src={`/book/${file}`} alt={alt} class="w-full" />
        ))}
      </div>

      <a href="/" class="inline-block text-text-muted text-[12px] font-light hover:text-text-primary transition-colors duration-300">← トップに戻る</a>

    </div>
  </div>
</Layout>
