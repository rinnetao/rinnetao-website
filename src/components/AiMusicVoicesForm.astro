<form id="ai-music-voices-form" class="not-prose mt-8 space-y-5 border border-accent-line p-5 md:p-7">
  <input type="hidden" name="access_key" value="b893875f-b41b-4bc0-926c-46c26cce4772" />
  <input type="hidden" name="subject" value="【AI MUSIC VOICES】質問・トークテーマ" />
  <input type="hidden" name="source" value="AI MUSIC VOICES" />
  <input type="text" name="botcheck" class="hidden" tabindex="-1" autocomplete="off" />

  <div>
    <label class="mb-2 block text-[11px] tracking-[0.12em] text-text-primary" for="amv-name">
      お名前・ハンドルネーム
    </label>
    <input
      id="amv-name"
      name="name"
      type="text"
      maxlength="30"
      placeholder="匿名でも投稿できます"
      class="w-full border border-white/[0.12] bg-[#131110] px-4 py-3 text-[14px] text-text-primary placeholder:text-text-faint focus:border-white/35 focus:outline-none"
    />
  </div>

  <div>
    <label class="mb-2 block text-[11px] tracking-[0.12em] text-text-primary" for="amv-message">
      質問・トークテーマ<span class="ml-1 text-accent-red">*</span>
    </label>
    <textarea
      id="amv-message"
      name="message"
      rows="7"
      maxlength="1000"
      required
      placeholder="二人に聞いてみたいこと、話してほしいテーマなど、自由にどうぞ！"
      class="w-full resize-y border border-white/[0.12] bg-[#131110] px-4 py-3 text-[14px] leading-relaxed text-text-primary placeholder:text-text-faint focus:border-white/35 focus:outline-none"
    ></textarea>
  </div>

  <button
    type="submit"
    class="flex h-11 w-full items-center justify-center rounded-sm bg-white px-5 text-center text-[12px] font-bold leading-none tracking-[0.15em] text-[#1a1a1a] transition-colors hover:bg-white/85 disabled:cursor-wait disabled:opacity-60"
  >
    送信する
  </button>
  <p id="ai-music-voices-status" class="hidden whitespace-pre-line text-center text-[13px] font-light leading-relaxed" aria-live="polite"></p>
</form>

<script>
  const form = document.getElementById('ai-music-voices-form') as HTMLFormElement | null;
  const status = document.getElementById('ai-music-voices-status');

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();

    const message = form.elements.namedItem('message') as HTMLTextAreaElement;
    const submitButton = form.querySelector('button[type="submit"]') as HTMLButtonElement;

    if (!message.value.trim()) {
      status!.textContent = '質問・トークテーマを入力してください。';
      status!.className = 'whitespace-pre-line text-center text-[13px] font-light leading-relaxed text-accent-red';
      message.focus();
      return;
    }

    submitButton.disabled = true;
    submitButton.textContent = '送信中…';
    status?.classList.add('hidden');

    try {
      const response = await fetch('https://api.web3forms.com/submit', {
        method: 'POST',
        headers: { Accept: 'application/json' },
        body: new FormData(form),
      });
      const result = await response.json();
      if (!result.success) throw new Error(result.message || 'send failed');
      await fetch('https://script.google.com/macros/s/AKfycbwnD6aKd_veeZEwYpiwFWctD0ITexndbtIlrnHJ70YrsOF5DO63CYR9vt1zrx312ECA/exec', {
        method: 'POST',
        mode: 'no-cors',
        body: new URLSearchParams(new FormData(form) as unknown as Record<string, string>),
      });

      form.reset();
      if (status) {
        status.textContent = 'ご投稿ありがとうございます☺️\n10月22日のライブ配信をお楽しみに👁️‍🗨️';
        status.className = 'whitespace-pre-line text-center text-[13px] font-light leading-relaxed text-text-primary';
      }
    } catch {
      if (status) {
        status.textContent = '送信に失敗しました。時間をおいて、もう一度お試しください。';
        status.className = 'whitespace-pre-line text-center text-[13px] font-light leading-relaxed text-accent-red';
      }
    } finally {
      submitButton.disabled = false;
      submitButton.textContent = '送信する';
    }
  });
</script>
