---
interface Props {
  href: string;
  position: 'banner' | 'end';
}

const { href, position } = Astro.props;
---

<div
  class:list={[
    'not-prose flex justify-center',
    position === 'banner' ? 'my-8' : 'mt-10 mb-8',
  ]}
  data-x-share-position={position}
>
  <a
    href={href}
    target="_blank"
    rel="noopener noreferrer"
    class="inline-flex min-h-11 w-full sm:w-auto items-center justify-center gap-3 border border-accent-line bg-white px-6 py-3 !text-[#1a1a1a] !no-underline transition-all duration-300 hover:bg-white/85"
    aria-label="Xでこの記事をシェアする"
  >
    <span class="text-[15px] font-semibold leading-none" aria-hidden="true">X</span>
    <span class="text-[11px] font-sans-jp font-bold tracking-[0.12em]">Xで記事をシェアする</span>
  </a>
</div>
