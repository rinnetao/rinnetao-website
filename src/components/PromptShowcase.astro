---
interface Props {
  label?: string;
  badges?: string[];
}
const { label = 'PROMPT', badges = [] } = Astro.props;
---
<div class="prompt-showcase not-prose relative my-8">
  <div class="ps-head">
    <span class="ps-label">{label}</span>
    <button type="button" aria-label="プロンプトを全文コピー" class="ps-copy-btn">
      <svg class="ps-copy-icon" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
      <svg class="ps-check-icon hidden" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
      <span class="ps-copy-text">全文コピー</span>
    </button>
  </div>

  {badges.length > 0 && (
    <div class="ps-badges">
      {badges.map((b) => <span class="ps-badge">{b}</span>)}
    </div>
  )}

  <div class="ps-body">
    <slot />
  </div>

  <div class="ps-foot">
    <button type="button" class="ps-copy-btn ps-copy-btn-wide" aria-label="プロンプトを全文コピー">
      <svg class="ps-copy-icon" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
      <svg class="ps-check-icon hidden" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
      <span class="ps-copy-text">プロンプトを全文コピー</span>
    </button>
  </div>
</div>

<style>
  .prompt-showcase {
    border: 1px solid #3d3a2e;
    background: #111008;
    box-shadow: 0 0 0 1px rgba(0, 0, 0, 0.4), 0 8px 30px rgba(0, 0, 0, 0.45);
  }

  .ps-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.7rem 0.9rem;
    border-bottom: 1px solid #2a2820;
    background: #1a1812;
  }

  .ps-label {
    font-size: 0.7rem;
    letter-spacing: 0.18em;
    color: #b8b0a4;
    text-transform: uppercase;
  }

  .ps-copy-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    padding: 0.4rem 0.75rem;
    font-size: 0.75rem;
    color: #f0ece4;
    background: rgba(0, 0, 0, 0.5);
    border: 1px solid #3d3a2e;
    cursor: pointer;
    transition: background-color 0.2s, border-color 0.2s;
    white-space: nowrap;
  }

  .ps-copy-btn:hover {
    background: #8b1a1a;
    border-color: #8b1a1a;
  }

  .ps-badges {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    padding: 0.75rem 0.9rem 0;
  }

  .ps-badge {
    font-size: 0.72rem;
    line-height: 1.4;
    color: #b8b0a4;
    border: 1px solid #2a2820;
    background: rgba(0, 0, 0, 0.35);
    padding: 0.22rem 0.55rem;
  }

  .ps-body {
    max-height: 30em;
    overflow-y: auto;
    overflow-x: hidden;
    padding: 0.25rem 0.2rem;
  }

  /* 日本語の長文プロンプトを横スクロールさせず折り返す */
  .ps-body :global(pre) {
    white-space: pre-wrap !important;
    word-break: break-word;
    overflow-x: hidden !important;
    margin: 0;
    padding: 0.9rem;
    background: transparent !important;
  }

  .ps-body :global(code) {
    white-space: pre-wrap !important;
    word-break: break-word;
    font-size: 0.82rem;
    line-height: 1.75;
  }

  .ps-body::-webkit-scrollbar {
    width: 10px;
  }

  .ps-body::-webkit-scrollbar-thumb {
    background: #3d3a2e;
  }

  .ps-foot {
    border-top: 1px solid #2a2820;
    padding: 0.7rem 0.9rem;
    background: #1a1812;
  }

  .ps-copy-btn-wide {
    width: 100%;
    padding: 0.6rem 0.75rem;
    font-size: 0.8rem;
  }

  .hidden {
    display: none;
  }
</style>

<script>
  document.querySelectorAll<HTMLButtonElement>('.ps-copy-btn').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const box = btn.closest('.prompt-showcase');
      const code = box?.querySelector('.ps-body code');
      if (!code) return;
      try {
        await navigator.clipboard.writeText(code.textContent || '');
        box?.querySelectorAll('.ps-copy-icon').forEach((i) => i.classList.add('hidden'));
        box?.querySelectorAll('.ps-check-icon').forEach((i) => i.classList.remove('hidden'));
        const labels = box?.querySelectorAll('.ps-copy-text');
        const originals: string[] = [];
        labels?.forEach((l, i) => {
          originals[i] = l.textContent || '';
          l.textContent = 'コピーしました';
        });
        setTimeout(() => {
          box?.querySelectorAll('.ps-copy-icon').forEach((i) => i.classList.remove('hidden'));
          box?.querySelectorAll('.ps-check-icon').forEach((i) => i.classList.add('hidden'));
          labels?.forEach((l, i) => {
            l.textContent = originals[i];
          });
        }, 1800);
      } catch (e) {
        // ignore
      }
    });
  });
</script>
